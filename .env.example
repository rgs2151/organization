# Local development identity.
ORGANIZATION_AUTH_MODE=development
ORGANIZATION_DEV_USER_ID=dev-rudra
ORGANIZATION_DEV_USER_NAME=Rudra
ORGANIZATION_DEV_USER_EMAIL=rgs2151@columbia.edu

# Optional overrides.
ORGANIZATION_HOST=127.0.0.1
ORGANIZATION_DATABASE_PATH=./var/organization.sqlite
ORGANIZATION_UPLOAD_PATH=./var/uploads
ORGANIZATION_API_PORT=3001

# Production uses Authentik forward-auth headers. The container defaults to these values.
# ORGANIZATION_AUTH_MODE=authentik-proxy
# ORGANIZATION_AUTHENTIK_APP_SLUG=organization

# Optional OAuth 2.1 resource-server support for ChatGPT and other interactive clients.
# ORGANIZATION_OAUTH_ISSUER=https://auth.singha.io/application/o/organization-mcp/
# ORGANIZATION_OAUTH_CLIENT_ID=organization-chatgpt
# ORGANIZATION_OAUTH_AUDIENCES=https://organization.singha.io/mcp,organization-chatgpt
