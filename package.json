{
  "name": "organization",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 3000",
    "dev:api": "tsx watch src/server/index.ts",
    "check": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json",
    "test": "tsx --test src/server/*.test.ts",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite": "^8.2.0"
  }
}
